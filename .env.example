# Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerinizi yazın.
# ".env" dosyası .gitignore'da olduğu için GitHub'a yüklenmez.

PORT=3000
ADMIN_USER=admin

# Önerilen: düz metin şifre yerine bcrypt hash'i kullanın.
# Üretmek için: npm run hash-password -- "seciminiz-olan-sifre"
ADMIN_PASS_HASH=

# ADMIN_PASS_HASH boşsa, geliştirme kolaylığı için bu düz metin şifre kullanılır
# (her açılışta otomatik hash'lenir). Yayında ADMIN_PASS_HASH kullanmanız önerilir.
ADMIN_PASS=guclu-bir-sifre-yazin

# Rastgele uzun bir metin (oturum token'larını imzalamak için)
SESSION_SECRET=rastgele-uzun-bir-metin
